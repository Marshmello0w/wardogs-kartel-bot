# Der Discord Bot Token
DISCORD_BOT_TOKEN=your_bot_token_here
GUILD_ID=your_discord_server_id_here

# Datenbank Verbindung
DB_CONNECTION_URL=mysql://user:password@host:port/dbname

# Channel ID für das Status-Embed aller drei Server
SERVER_STATUS_CHANNEL_ID=your_channel_id_here
# Channel ID für den täglichen Server-Rückblick (00:00 Uhr, Europe/Berlin)
SERVER_RECAP_CHANNEL_ID=your_channel_id_here
DISCORD_LOG_CHANNEL_ID=your_log_channel_id_here

# -----------------
# Leaderboard Server 1, 2 & 3
# -----------------
LEADERBOARD_CHANNEL_ID="KanalID_Fuer_Alle_Leaderboards"

SERVER1_RCON_URL="https://RCON_SERVER_1:PORT"
SERVER1_RCON_PASS="PASSWORT_SERVER_1"

SERVER2_RCON_URL="https://RCON_SERVER_2:PORT"
SERVER2_RCON_PASS="PASSWORT_SERVER_2"

SERVER3_RCON_URL="https://RCON_SERVER_3:PORT"
SERVER3_RCON_PASS="PASSWORT_SERVER_3"
RCON_TIMEOUT_SECONDS=10

# -----------------
# Map Voting Feature
# -----------------
SERVER2_VOTE_CHANNEL_ID="KanalID_Fuer_Voting_Server2"
SERVER3_VOTE_CHANNEL_ID="KanalID_Fuer_Voting_Server3"
ADMIN_ROLE_IDS="Rollen_ID_1,Rollen_ID_2"
# Leere ADMIN_ROLE_IDS erlauben ausschließlich Discord-Administratoren.
# IDs durch Ziffern ersetzen; ungültige Kanal-IDs deaktivieren die jeweilige Anzeige.
ADMIN_PANEL_CHANNEL_ID="KanalID_Fuer_Admin_Panel"

# Wardogs Masterlist UUIDs für Server-Status
SERVER_IDS="UUID_Server1,UUID_Server2,UUID_Server3"
