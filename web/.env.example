PUBLIC_BASE_URL=https://kartell.marshmello0w.de
WEB_DB_CONNECTION_URL=mysql://kartell_web:URL_ENCODED_PASSWORD@DATABASE_HOST:3306/DATABASE_NAME
# Separate user with INSERT on reward_requests only; never use the read-only account here.
WEB_REWARD_DB_CONNECTION_URL=mysql://kartell_rewards_submit:URL_ENCODED_PASSWORD@DATABASE_HOST:3306/DATABASE_NAME
# Enable ingress only after all three tokens and the INSERT-only feed DB user
# have been configured. Events are processed locally, not forwarded to a provider.
WEB_FEED_ENABLED=false
WEB_FEED_DB_CONNECTION_URL=mysql://kartell_feed_ingress:URL_ENCODED_PASSWORD@DATABASE_HOST:3306/DATABASE_NAME
WEB_FEED_TOKEN_SERVER1=
WEB_FEED_TOKEN_SERVER2=
WEB_FEED_TOKEN_SERVER3=
STEAM_WEB_API_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SESSION_SECRET=
